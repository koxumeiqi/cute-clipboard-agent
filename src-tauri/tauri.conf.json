{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cute Clipboard Agent",
  "version": "0.1.0",
  "identifier": "com.cutecb.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "Cute Clipboard Agent",
        "width": 168,
        "height": 188,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
